{
  "name": "EmploymentRecord",
  "type": "object",
  "properties": {
    "employer_name": {
      "type": "string"
    },
    "job_title": {
      "type": "string"
    },
    "experience_type": {
      "type": "string",
      "enum": [
        "Regular paid job",
        "Temporary or day labor",
        "Self-employment",
        "Side jobs",
        "Volunteer work",
        "Caregiving",
        "Work while incarcerated",
        "School or training projects",
        "Community service",
        "No experience yet"
      ],
      "default": "Regular paid job"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "google_place_id": {
      "type": "string"
    },
    "street_address": {
      "type": "string"
    },
    "postal_code": {
      "type": "string"
    },
    "employer_type": {
      "type": "string"
    },
    "responsibilities_selected": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "responsibilities_custom": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "additional_notes": {
      "type": "string"
    },
    "start_month": {
      "type": "string"
    },
    "start_year": {
      "type": "string"
    },
    "end_month": {
      "type": "string"
    },
    "end_year": {
      "type": "string"
    },
    "currently_employed": {
      "type": "boolean",
      "default": false
    },
    "supervisor_name": {
      "type": "string"
    },
    "supervisor_phone": {
      "type": "string"
    },
    "supervisor_email": {
      "type": "string"
    },
    "permission_to_contact": {
      "type": "boolean",
      "default": false
    },
    "duties": {
      "type": "string"
    },
    "accomplishments": {
      "type": "string"
    },
    "reason_for_leaving": {
      "type": "string"
    },
    "starting_pay": {
      "type": "string"
    },
    "ending_pay": {
      "type": "string"
    },
    "hours_per_week": {
      "type": "number"
    },
    "employment_type": {
      "type": "string",
      "enum": [
        "Full-time",
        "Part-time",
        "Temporary",
        "Contract",
        "Seasonal"
      ]
    },
    "verified_status": {
      "type": "string",
      "enum": [
        "User Entered",
        "Document Extracted",
        "User Confirmed",
        "Needs Confirmation",
        "Do Not Use"
      ],
      "default": "User Entered"
    },
    "source_document_id": {
      "type": "string"
    }
  },
  "required": [
    "employer_name",
    "job_title"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}