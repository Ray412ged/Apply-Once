{
  "name": "Organization",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "organization_type": {
      "type": "string",
      "enum": [
        "Workforce Partner",
        "Nonprofit",
        "Government",
        "Educational Institution",
        "Employer",
        "Training Provider",
        "Other"
      ],
      "default": "Other"
    },
    "logo_url": {
      "type": "string"
    },
    "primary_color": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "description": "URL path segment for this organization's branded dashboard, e.g. 'goodwill-pittsburgh' for /org/goodwill-pittsburgh. Set by an admin at creation."
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "organization_type"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}