{
  "name": "EducationRecord",
  "type": "object",
  "properties": {
    "institution_name": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "education_type": {
      "type": "string",
      "enum": [
        "High School",
        "GED",
        "Trade School",
        "Community College",
        "College",
        "University",
        "Training Program",
        "Other"
      ]
    },
    "degree_or_credential": {
      "type": "string"
    },
    "field_of_study": {
      "type": "string"
    },
    "start_year": {
      "type": "string"
    },
    "graduation_year": {
      "type": "string"
    },
    "completed": {
      "type": "boolean",
      "default": false
    },
    "graduation_date": {
      "type": "string",
      "format": "date"
    },
    "GPA": {
      "type": "string"
    },
    "honors": {
      "type": "string"
    },
    "verified_status": {
      "type": "string",
      "enum": [
        "User Entered",
        "Document Extracted",
        "User Confirmed",
        "Needs Confirmation",
        "Do Not Use"
      ],
      "default": "User Entered"
    },
    "source_document_id": {
      "type": "string"
    }
  },
  "required": [
    "institution_name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}