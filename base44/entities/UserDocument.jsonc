{
  "name": "UserDocument",
  "type": "object",
  "properties": {
    "document_name": {
      "type": "string"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "Resume",
        "Cover Letter",
        "Transcript",
        "License",
        "Certification",
        "Reference List",
        "Work Sample",
        "Other"
      ]
    },
    "file_url": {
      "type": "string"
    },
    "upload_date": {
      "type": "string",
      "format": "date-time"
    },
    "processing_status": {
      "type": "string",
      "enum": [
        "Pending",
        "Processing",
        "Completed",
        "Failed"
      ],
      "default": "Pending"
    },
    "extraction_status": {
      "type": "string",
      "enum": [
        "Not Started",
        "In Progress",
        "Completed",
        "Failed"
      ],
      "default": "Not Started"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "User Entered",
        "Document Extracted",
        "User Confirmed",
        "Needs Confirmation",
        "Do Not Use"
      ],
      "default": "User Entered"
    },
    "user_notes": {
      "type": "string"
    },
    "contains_sensitive_information": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "document_name",
    "document_type"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}