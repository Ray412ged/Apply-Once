{
  "name": "Skill",
  "type": "object",
  "properties": {
    "skill_name": {
      "type": "string"
    },
    "skill_category": {
      "type": "string",
      "enum": [
        "Dependability",
        "Working with people",
        "Hands-on work",
        "Office and technology",
        "Leadership and thinking",
        "Other"
      ],
      "default": "Other"
    },
    "proficiency_level": {
      "type": "string",
      "enum": [
        "Beginner",
        "Intermediate",
        "Advanced",
        "Expert"
      ],
      "default": "Intermediate"
    },
    "years_experience": {
      "type": "number"
    },
    "source": {
      "type": "string",
      "enum": [
        "User Entered",
        "Document Extracted",
        "Inferred"
      ],
      "default": "User Entered"
    },
    "confirmed_by_user": {
      "type": "boolean",
      "default": false
    },
    "suggested_from_employment": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "skill_name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}