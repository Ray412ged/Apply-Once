{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string"
    },
    "middle_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "preferred_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "postal_code": {
      "type": "string"
    },
    "preferred_contact_method": {
      "type": "string",
      "enum": [
        "Email",
        "Phone",
        "Text"
      ],
      "default": "Email"
    },
    "professional_summary": {
      "type": "string"
    },
    "interview_introduction": {
      "type": "string"
    },
    "strength_words": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "strength_statement": {
      "type": "string"
    },
    "story_proud_of": {
      "type": "string"
    },
    "story_motivates": {
      "type": "string"
    },
    "story_employer_should_know": {
      "type": "string"
    },
    "growth_experiences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "growth_lessons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "growth_statement": {
      "type": "string"
    },
    "education_level_answer": {
      "type": "string"
    },
    "credentials_status": {
      "type": "string"
    },
    "references_status": {
      "type": "string"
    },
    "last_resume_signature": {
      "type": "string"
    },
    "profile_completion_percentage": {
      "type": "number",
      "default": 0
    },
    "onboarding_status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "completed"
      ],
      "default": "not_started"
    },
    "profile_entry_method": {
      "type": "string",
      "enum": [
        "resume_import",
        "manual"
      ]
    },
    "consent_to_ai_processing": {
      "type": "boolean",
      "default": false
    },
    "consent_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "privacy_acknowledged": {
      "type": "boolean",
      "default": false
    },
    "terms_acknowledged": {
      "type": "boolean",
      "default": false
    },
    "employment_status": {
      "type": "string",
      "enum": [
        "Searching",
        "Offer Accepted"
      ],
      "default": "Searching",
      "description": "Participant-initiated only. Reversible \u2014 an accepted offer can fall through, so participants can revert to Searching at any time."
    },
    "current_employer_name": {
      "type": "string"
    },
    "current_position_title": {
      "type": "string"
    },
    "offer_accepted_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "first_name",
    "last_name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}