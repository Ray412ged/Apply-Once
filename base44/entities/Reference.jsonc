{
  "name": "Reference",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "relationship": {
      "type": "string"
    },
    "organization": {
      "type": "string"
    },
    "job_title": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "years_known": {
      "type": "number"
    },
    "permission_confirmed": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "full_name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}