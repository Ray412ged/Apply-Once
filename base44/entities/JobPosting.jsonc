{
  "name": "JobPosting",
  "type": "object",
  "properties": {
    "job_title": {
      "type": "string"
    },
    "employer_name": {
      "type": "string"
    },
    "company_logo_url": {
      "type": "string"
    },
    "company_website": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "postal_code": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "remote_type": {
      "type": "string",
      "enum": [
        "On-site",
        "Hybrid",
        "Remote",
        "Not specified"
      ],
      "default": "Not specified"
    },
    "employment_type": {
      "type": "string",
      "enum": [
        "Full-time",
        "Part-time",
        "Temporary",
        "Contract",
        "Seasonal",
        "Internship"
      ]
    },
    "industry": {
      "type": "string"
    },
    "experience_level_required": {
      "type": "string",
      "enum": [
        "No experience",
        "Less than 1 year",
        "1\u20133 years",
        "3\u20135 years",
        "5\u201310 years",
        "10+ years"
      ]
    },
    "salary_min": {
      "type": "number"
    },
    "salary_max": {
      "type": "number"
    },
    "salary_text": {
      "type": "string"
    },
    "salary_currency": {
      "type": "string",
      "default": "USD"
    },
    "salary_period": {
      "type": "string",
      "enum": [
        "hourly",
        "annual",
        "monthly",
        "weekly"
      ]
    },
    "benefits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schedule": {
      "type": "string"
    },
    "posting_url": {
      "type": "string"
    },
    "application_url": {
      "type": "string"
    },
    "ats_type": {
      "type": "string"
    },
    "department": {
      "type": "string"
    },
    "facility": {
      "type": "string"
    },
    "easy_apply": {
      "type": "boolean",
      "default": false
    },
    "provider": {
      "type": "string",
      "enum": [
        "adzuna",
        "usajobs",
        "greenhouse",
        "lever",
        "isolved_hire",
        "ashby",
        "company_career",
        "employer_portal",
        "manual"
      ],
      "default": "manual"
    },
    "source_name": {
      "type": "string"
    },
    "external_job_id": {
      "type": "string"
    },
    "provider_data": {
      "type": "string"
    },
    "import_date": {
      "type": "string",
      "format": "date-time"
    },
    "last_synced_date": {
      "type": "string",
      "format": "date-time"
    },
    "posting_date": {
      "type": "string",
      "format": "date"
    },
    "expiration_date": {
      "type": "string",
      "format": "date"
    },
    "application_deadline": {
      "type": "string",
      "format": "date"
    },
    "full_description": {
      "type": "string"
    },
    "responsibilities": {
      "type": "string"
    },
    "minimum_qualifications": {
      "type": "string"
    },
    "preferred_qualifications": {
      "type": "string"
    },
    "required_education": {
      "type": "string"
    },
    "required_experience": {
      "type": "string"
    },
    "required_credentials": {
      "type": "string"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    },
    "organization_id": {
      "type": "string"
    },
    "org_employer_id": {
      "type": "string"
    },
    "opportunity_type": {
      "type": "string",
      "enum": [
        "Job",
        "Apprenticeship",
        "Work Experience"
      ],
      "default": "Job"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "Unverified",
        "Verified",
        "Rejected",
        "Returned"
      ],
      "default": "Unverified"
    },
    "submitted_by_staff_id": {
      "type": "string"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "verified_by_staff_id": {
      "type": "string"
    },
    "review_note": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Active",
        "Expired",
        "Filled",
        "Removed",
        "Demo Data"
      ],
      "default": "Draft"
    },
    "administrator_verified": {
      "type": "boolean",
      "default": false
    },
    "local_job": {
      "type": "boolean",
      "default": false
    },
    "source_employer": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "employer_source_id": {
      "type": "string"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "application_method": {
      "type": "string",
      "enum": [
        "External website",
        "Email employer",
        "Call employer",
        "Apply in person",
        "Employer instructions",
        "Future Apply Once employer application"
      ]
    },
    "application_email": {
      "type": "string"
    },
    "application_phone": {
      "type": "string"
    },
    "application_instructions": {
      "type": "string"
    },
    "number_of_openings": {
      "type": "number"
    },
    "background_requirements": {
      "type": "string"
    },
    "apprenticeship_available": {
      "type": "boolean",
      "default": false
    },
    "second_chance_friendly": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "job_title",
    "employer_name",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}