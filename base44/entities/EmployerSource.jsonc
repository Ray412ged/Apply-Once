{
  "name": "EmployerSource",
  "type": "object",
  "properties": {
    "employer_name": {
      "type": "string"
    },
    "employer_type": {
      "type": "string",
      "enum": [
        "Restaurant",
        "University",
        "Construction",
        "Nonprofit",
        "Small Business",
        "Workforce Partner",
        "Government",
        "Healthcare",
        "Retail",
        "Manufacturing",
        "Other"
      ],
      "default": "Other"
    },
    "industry": {
      "type": "string"
    },
    "website_url": {
      "type": "string"
    },
    "careers_page_url": {
      "type": "string"
    },
    "provider_type": {
      "type": "string",
      "enum": [
        "Manual",
        "CSV Import",
        "Greenhouse",
        "Lever",
        "iSolved Hire",
        "USAJOBS",
        "Taleo",
        "Phenom",
        "Structured Career Page",
        "Future Employer Portal"
      ],
      "default": "Manual"
    },
    "provider_identifier": {
      "type": "string"
    },
    "application_url_pattern": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "postal_code": {
      "type": "string"
    },
    "service_area": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "brand_primary_color": {
      "type": "string"
    },
    "brand_secondary_color": {
      "type": "string"
    },
    "known_application_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resume_required": {
      "type": "boolean",
      "default": true
    },
    "cover_letter_optional": {
      "type": "boolean",
      "default": true
    },
    "account_required": {
      "type": "boolean",
      "default": false
    },
    "contact_name": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "source_status": {
      "type": "string",
      "enum": [
        "Active",
        "Inactive",
        "Pending",
        "Error"
      ],
      "default": "Pending"
    },
    "last_sync_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_sync_result": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "approved": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "employer_name",
    "provider_type"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}