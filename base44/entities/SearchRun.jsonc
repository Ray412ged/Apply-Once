{
  "name": "SearchRun",
  "type": "object",
  "properties": {
    "run_date": {
      "type": "string",
      "format": "date-time"
    },
    "run_type": {
      "type": "string",
      "enum": [
        "Job Import",
        "Job Match",
        "Extraction",
        "Scheduled",
        "Manual"
      ]
    },
    "number_of_active_users": {
      "type": "number"
    },
    "number_of_jobs_reviewed": {
      "type": "number"
    },
    "number_of_matches_created": {
      "type": "number"
    },
    "success_status": {
      "type": "string",
      "enum": [
        "Success",
        "Partial",
        "Failed"
      ],
      "default": "Success"
    },
    "error_message": {
      "type": "string"
    }
  },
  "required": [
    "run_date",
    "run_type"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}