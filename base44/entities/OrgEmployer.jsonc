{
  "name": "OrgEmployer",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "employer_name": {
      "type": "string"
    },
    "normalized_name": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "website_url": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "postal_code": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Lead",
        "Active",
        "Inactive",
        "Archived"
      ],
      "default": "Lead"
    },
    "relationship_owner_staff_id": {
      "type": "string"
    },
    "last_activity_date": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    },
    "created_by_staff_id": {
      "type": "string"
    },
    "source": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "employer_name",
    "normalized_name",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "system_only"
      }
    },
    "create": {
      "user_condition": {
        "role": "system_only"
      }
    },
    "update": {
      "user_condition": {
        "role": "system_only"
      }
    },
    "delete": {
      "user_condition": {
        "role": "system_only"
      }
    }
  }
}