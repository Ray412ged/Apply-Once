{
  "name": "AdminAccessLog",
  "type": "object",
  "properties": {
    "admin_id": {
      "type": "string"
    },
    "participant_id": {
      "type": "string"
    },
    "organization_id": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "admin_id",
    "reason",
    "timestamp"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "system_only"
      }
    },
    "update": {
      "user_condition": {
        "role": "system_only"
      }
    },
    "delete": {
      "user_condition": {
        "role": "system_only"
      }
    }
  }
}