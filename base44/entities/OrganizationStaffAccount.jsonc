{
  "name": "OrganizationStaffAccount",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "The user id of the staff member. Distinct from created_by_id, since this row must be created by an admin, never by the staff member themselves."
    },
    "organization_id": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "org_role": {
      "type": "string",
      "enum": [
        "org_admin",
        "staff"
      ],
      "default": "staff"
    },
    "display_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "connect_code": {
      "type": "string"
    },
    "deactivated_at": {
      "type": "string",
      "format": "date-time"
    },
    "deactivated_by": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "organization_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}