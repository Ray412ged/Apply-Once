{
  "name": "Credential",
  "type": "object",
  "properties": {
    "credential_name": {
      "type": "string"
    },
    "issuing_organization": {
      "type": "string"
    },
    "credential_type": {
      "type": "string",
      "enum": [
        "License",
        "Certification",
        "Permit",
        "Other"
      ]
    },
    "credential_number_optional": {
      "type": "string"
    },
    "issue_date": {
      "type": "string",
      "format": "date"
    },
    "expiration_date": {
      "type": "string",
      "format": "date"
    },
    "state": {
      "type": "string"
    },
    "active_status": {
      "type": "boolean",
      "default": true
    },
    "verified_status": {
      "type": "string",
      "enum": [
        "User Entered",
        "Document Extracted",
        "User Confirmed",
        "Needs Confirmation",
        "Do Not Use"
      ],
      "default": "User Entered"
    },
    "source_document_id": {
      "type": "string"
    }
  },
  "required": [
    "credential_name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}